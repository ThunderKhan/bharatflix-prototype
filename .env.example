# Local persistent SQLite demo. Use a writable persistent volume; not ephemeral serverless storage.
BHARATFLIX_DATABASE_PATH=.local-data/bharatflix.sqlite
# Optional reverse-proxy canonical application origin; exact match enforced on cookie-authenticated state-changing APIs.
# BHARATFLIX_APP_ORIGIN=https://your-demo.example
# One-time bootstrap: set these in your shell (NOT in committed files) before npm run bootstrap:superadmin
# BHARATFLIX_BOOTSTRAP_EMAIL=owner@example.com
# BHARATFLIX_BOOTSTRAP_PASSWORD=strong-unique-password-min-12
